# odin-gtksourceview: its place in the binding graph
# Render:  d2 diags/odin-gtksourceview.d2 diags/odin-gtksourceview.svg

direction: down

title: "odin-gtksourceview" {
  shape: text
  near: top-center
  style.font-size: 28
  style.bold: true
}

this: "odin-gtksourceview\nGtkSourceView 5 5.12.0" {
  style.fill: "#eef6ff"
}
lib: "gtksourceview-5 (shared library)" {
  style.fill: "#fff6e6"
}
consumers: "every other binding and every app\nimport \"gtksourceview:<pkg>\"" {
  style.fill: "#f2f2f2"
}

consumers -> this: collection gtksourceview
this -> lib: foreign import
